# Copy to kiln.env to run on your own computer.
# On Railway, enter these as service Variables instead (never commit real values).

# --- KilnAid (required for the kiln panel) ---
KILNAID_EMAIL=you@example.com
KILNAID_PASSWORD=your-kilnaid-password

# Optional: only watch some kilns (parts of KilnAid names or serials, comma separated).
# Leave blank to watch every kiln on the account.
KILNS=
# How often to check the kilns, in minutes (used for the firing log)
POLL_MINUTES=5
# Where the firing log is saved. On Railway, mount a volume at /data and use /data.
DATA_DIR=./data

# --- Weather (required for the weather panel) ---
LATITUDE=45.52
LONGITUDE=-122.68
LOCATION_NAME=Portland
TEMP_UNIT=F
# Days with a chance of precipitation ABOVE this percent are highlighted
RAIN_THRESHOLD=10

# --- Display ---
TIMEZONE=America/Los_Angeles
# Minutes between refreshes, aligned to the clock (60 = on the hour)
REFRESH_MINUTES=60
# Optional: only serve these device MAC addresses (comma separated)
DEVICE_ID=
